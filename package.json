{
  "name": "travopaz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的旅行规划工作台",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server electron tests scripts docs README.md package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts index.html",
    "schema": "node --import tsx scripts/generate-schema.ts",
    "test:electron": "node --import tsx tests/electron/smoke.ts",
    "electron": "npm run build && node scripts/start-electron.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
